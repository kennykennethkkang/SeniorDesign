# Python build/cache artifacts
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.benchmarks/
*.py[cod]
*.pyo
*.log
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
.venv/
.venv_*/
.python-version
.ipynb_checkpoints/

# Editor / OS: user-specific files that shouldn't follow the repo around
.local_dashboard/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.orig
*.tmp
*.temp
tmp/

# Node / frontend build outputs (we ship the React/TS source, not the built bundles)
node_modules/
frontend/node_modules/
frontend/app/node_modules/
frontend/dist/
frontend/app/dist/
frontend/static/dist/
frontend/app/tsconfig.tsbuildinfo
# Vite + npm side effects we don't want creeping in
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.parcel-cache/
.cache-loader/
*.tsbuildinfo

# Hand-written JS doesn't need source maps committed; if we ever build
# the dist bundle we ignore the maps too.
frontend/static/dist/*.map
frontend/static/js/*.map

# Project-local data: these dirs are write-once-per-run and personal to this host.
audio_in/
job_logs/
job_outputs/
sbatch_runtime/
fine_tuning/projects/
fine_tuning/label_work/
stitched/
youtube_links_err/*.tsv

# SLURM scratch: wallclock outputs, error logs, and pid/url scratch files
# don't belong in the repo. The sbatch templates in scheduler/ stay tracked.
slurm-*.out
slurm-*.err
*.slurm.out
*.slurm.err
*.pid
*.url

# Ad-hoc fine-tune/diarization test runs. These are throwaway scratch
# directories from manual smoke tests, full of SLURM logs and run outputs.
test_finetune_*/
test_finetune_*.sbatch

# Bulk archives (corpus dumps, slurm bundles): never push these to GitHub;
# they're either reproducible from the public source or too big for git.
combined.zip
*.zip
*.tar
*.tar.gz
*.tgz

# Full diarization runs are huge; the index TSV stays tracked so reruns can dedupe.
outputs/diarization_runs/
outputs/youtube_conversion_runs/
# (intentionally keep) outputs/youtube_conversion_history/url_audio_index.tsv

# ---- Sensitive data: belt-and-suspenders ------------------------------------
# Anything that smells like a credential should never get committed by mistake,
# even if I forget which dotfile a secret was hiding in.
.env
.env.*
*.env
.envrc
secrets/
**/credentials*
**/*api_key*
**/*api-key*
*.pem
*.key
*.pfx
id_rsa
id_ed25519
id_*.pub
.ssh/

# Hugging Face / Torch caches occasionally land beside the project when a job
# runs with HF_HOME unset. Don't let those leak into the repo.
.hf_cache/
hf_cache/
.cache/
huggingface/

# ---- Model weights and large media ------------------------------------------
# These are bigger than git can comfortably handle and are reproducible from
# the training scripts; never commit them.
*.ckpt
*.pt
*.pth
*.nemo
*.onnx
*.safetensors
*.bin
*.tflite

# Audio / video: recordings can contain identifiable voices; we treat them as
# data, not source. The one tracked test.opus under archive/ stays tracked
# (git only ignores untracked files, so this won't disturb it).
*.wav
*.mp3
*.m4a
*.flac
*.opus
*.ogg
*.aac
*.mp4
*.mkv
*.webm
