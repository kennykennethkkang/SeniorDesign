{
  "name": "senior-design-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vite + React + TypeScript dashboard. Build outputs to ../static/dist so the existing Python WSGI server can serve it as a static asset without changes to the routing layer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
